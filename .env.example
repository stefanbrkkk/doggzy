# Public site URL. Used for canonical links, the sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://doggzy.rs

# --- Admin authentication -----------------------------------------------
# Generate AUTH_SECRET and ADMIN_PASSWORD_HASH with: npm run admin:hash
# The hash is colon-delimited (scrypt:salt:hash) because dotenv expands `$`
# inside .env values and would truncate a `$`-delimited hash.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Outbound email (optional) -------------------------------------------
# Without these, form submissions are validated and logged on the server
# instead of being emailed. The submitter still gets a success response.
RESEND_API_KEY=
NOTIFY_TO=
NOTIFY_FROM=Doggzy <onboarding@resend.dev>
